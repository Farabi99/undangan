<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Moderasi Ucapan — Admin Undangan</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=<%= Date.now() %>">
  <link rel="icon" type="image/svg+xml" href="/img/logo-fs-badge.svg?v=<%= Date.now() %>">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

  <nav class="admin-nav">
    <div class="admin-nav-brand">💍 Admin Undangan</div>
    <div class="admin-nav-links">
      <a href="/admin/guests">Daftar Tamu</a>
      <a href="/admin/import">Import Spreadsheet</a>
      <a href="/admin/rsvps">Rekap RSVP</a>
      <a href="/admin/wishes" class="active">Moderasi Ucapan</a>
      <a href="/" target="_blank">Lihat Web ↗</a>
      <a href="/admin/logout" style="color: #FFA39E;">Keluar</a>
    </div>
  </nav>

  <div class="admin-container">
    <div class="admin-card">
      <div class="admin-header-row">
        <div>
          <h2 style="font-size: 1.15rem; margin: 0 0 0.25rem 0;">Moderasi Doa &amp; Ucapan Tamu (<%= wishes.length %>)</h2>
          <p style="font-size: 0.85rem; color: var(--admin-text-sub); margin: 0;">
            Anda dapat menyembunyikan ucapan yang tidak pantas agar tidak muncul di halaman website tamu.
          </p>
        </div>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Waktu</th>
              <th>Nama Tamu</th>
              <th>Kehadiran</th>
              <th>Isi Doa &amp; Ucapan</th>
              <th>Status di Web</th>
              <th style="text-align: right;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (wishes.length === 0) { %>
              <tr>
                <td colspan="6" style="text-align: center; color: var(--admin-text-sub); padding: 2rem;">
                  Belum ada doa dan ucapan yang masuk.
                </td>
              </tr>
            <% } %>

            <% wishes.forEach(function(w) { %>
              <tr style="<%= w.is_hidden ? 'background: #FFF1F0; opacity: 0.8;' : '' %>">
                <td style="white-space: nowrap; font-size: 0.78rem; color: var(--admin-text-sub);">
                  <%= w.created_at %>
                </td>
                <td>
                  <strong><%= w.name %></strong>
                  <% if (w.grp) { %>
                    <span style="font-size: 0.75rem; color: var(--admin-text-sub); display: block;"><%= w.grp %></span>
                  <% } %>
                </td>
                <td>
                  <% if (w.attending === 1) { %>
                    <span class="badge badge-success">Hadir</span>
                  <% } else { %>
                    <span class="badge badge-danger">Tidak Hadir</span>
                  <% } %>
                </td>
                <td style="max-width: 360px; font-size: 0.9rem; line-height: 1.5;">
                  “<%= w.wish %>”
                </td>
                <td>
                  <% if (w.is_hidden === 1) { %>
                    <span class="badge badge-danger">Disembunyikan</span>
                  <% } else { %>
                    <span class="badge badge-success">Tampil</span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <form action="/admin/wishes/<%= w.id %>/toggle" method="POST" style="display: inline;">
                    <% if (w.is_hidden === 1) { %>
                      <button type="submit" class="btn-adm btn-adm-outline" style="color: var(--admin-success);">
                        👁 Tampilkan
                      </button>
                    <% } else { %>
                      <button type="submit" class="btn-adm btn-adm-danger">
                        🚫 Sembunyikan
                      </button>
                    <% } %>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</body>
</html>
